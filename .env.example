# Copie este arquivo para `.env` na raiz do projeto (ao lado de package.json):
#
#   copy .env.example .env
#
# Salve e reinicie o `npm run dev`. O Next.js só lê o .env na subida do servidor.
# Tudo que NÃO começa com NEXT_PUBLIC_ fica só no servidor — nunca no navegador.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# URL pública do site, sem barra no final.
# Local:        http://localhost:3000
# Túnel/prod:   https://seu-dominio.com
# O link de download do CSV e (em https) a URL do webhook usam este valor.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo nosso, para assinar o link de download. Não é chave de terceiro.
# Gere um valor e cole na linha de baixo, sem aspas:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_TOKEN_SECRET=

# Opcional. Se preenchido, aparece no rodapé e como reply-to do e-mail.
# SUPPORT_EMAIL=suporte@seudominio.com

# ---------------------------------------------------------------------------
# Mercado Pago  →  https://www.mercadopago.com.br/developers/panel/app
# ---------------------------------------------------------------------------
# 1. Crie uma aplicação no painel de desenvolvedores.
# 2. Credenciais de teste → copie o Access Token (começa com TEST-).
# 3. Em produção, troque pelo Access Token de produção.
# 4. Webhooks → URL de notificação: https://SEU_DOMINIO/api/webhook
#    Evento: pagamentos. Copie o secret da assinatura para MP_WEBHOOK_SECRET.
# Em localhost o Mercado Pago não alcança a sua máquina. Use a URL https
# do site (ou de um túnel) em NEXT_PUBLIC_APP_URL para o webhook entrar na preferência.

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Resend  →  https://resend.com/api-keys
# ---------------------------------------------------------------------------
# 1. Crie uma API key e cole em RESEND_API_KEY.
# 2. Sem domínio verificado, use onboarding@resend.dev — o Resend só entrega
#    no e-mail da sua própria conta.
# 3. Em produção, verifique um domínio (ex. leadsfera.com.br) e troque o from
#    para algo como: LeadSfera <entregas@leadsfera.com.br>

RESEND_API_KEY=
RESEND_FROM_EMAIL=LeadSfera <onboarding@resend.dev>
